// Contract Smart: the tables that exist today (group 1 of docs/thiet-ke-thu-vien-moc.dbml).
// Paste into https://dbdiagram.io/d to see the diagram. The full target design is in thiet-ke-thu-vien-moc.dbml.
// Every table also has: version (optimistic lock), created_at, updated_at.

Project contract_smart {
  database_type: 'PostgreSQL'
}

Table event_types [headercolor: #b5641b] {
  id integer [pk, increment]
  name text [not null, note: 'Giao hang']
  category text [not null, note: 'EVIDENCE | APPROVAL | REJECTION | DISPUTE_OPEN | DISPUTE_RESOLVE | OTHER']
  actor_side text [null, note: 'chi voi EVIDENCE: BUYER | SUPPLIER']
  valid_status text [not null, note: 'may tu dien khi ghi su kien: CONFIRMED | APPROVED | REJECTED | OPEN | RESOLVED']
  active boolean [not null, default: true]
  Note: 'Danh muc loai su kien'
}

Table parties [headercolor: #1f7a5a] {
  id integer [pk, increment]
  name text [not null, note: 'Nova An Business JSC']
  type text [not null, note: 'BUYER | SUPPLIER | APPROVER']
  parent_id integer [null, ref: > parties.id, note: 'nguoi phe duyet thuoc ben mua nao']
  approval_role text [null, note: 'CONTRACT_OWNER | FINANCE_APPROVER | SECONDARY_APPROVER']
  approval_limit_vnd_mn "numeric(18,2)" [null, note: 'han muc duoc duyet']
  allowed_event_type_ids "integer[]" [not null, note: '{1,2}: duoc ghi loai su kien nao (API kiem tung id)']
  active boolean [not null, default: true]
  Note: 'Cac ben: ben mua, nha cung cap, nguoi phe duyet cua ben mua'
}

Table users [headercolor: #1f7a5a] {
  id uuid [pk]
  email text [unique, not null]
  password_hash text [not null]
  full_name text [not null]
  role text [not null, note: 'CONTRACT_OWNER | LEGAL_REVIEWER | FINANCE_APPROVER | SECONDARY_APPROVER | ADMIN_AUDITOR | SUPPLIER | SYSTEM_ADMIN | AUDITOR']
  party_id integer [null, ref: > parties.id, note: 'NULL voi SYSTEM_ADMIN, AUDITOR']
  active boolean [not null, default: true]
  Note: 'Tai khoan dang nhap'
}
