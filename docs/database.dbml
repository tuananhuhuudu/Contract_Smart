// Contract Smart: the tables that exist today (TypeORM models in apps/api/src/models).
// Paste into https://dbdiagram.io/d to see the diagram.
// Every table also has the BaseModel columns: version, created_at, updated_at.
// Columns the Data Pack repeats are not stored; the views engine_parties, engine_contracts,
// engine_milestones and engine_payment_rules rebuild them for the engine (checked: 14,850 cells, 0 diff);
// the template name and rule set id of a type come from the view contract_type_labels.

Project contract_smart {
  database_type: 'PostgreSQL'
  Note: 'Luong: loai hop dong -> khuon moc + bo luat -> phien ban luat -> hop dong -> moc'
}

// ============================ Cau hinh ============================

Table contract_types [headercolor: #7a4fd1] {
  code text [pk, note: 'GOODS_SUPPLY']
  name text [note: 'Cung cap hang hoa']
  active boolean [default: true]
  version integer
  created_at timestamptz
  updated_at timestamptz
  Note: 'Loai hop dong; khuon = cac dong contract_type_stages, bo luat = cac dong rule_scopes'
}

Table rule_scopes [headercolor: #7a4fd1] {
  release_rule_code text [pk, note: 'R_GOODS_STD:DELIVERY']
  contract_type text [ref: > contract_types.code]
  milestone_type text [note: 'DELIVERY']
  name text [note: 'Giao hang - hang hoa']
  version integer
  created_at timestamptz
  updated_at timestamptz
  indexes {
    (contract_type, milestone_type) [unique, note: 'moi loai moc 1 bo luat']
    (contract_type, release_rule_code) [unique, note: 'dich cua khoa ghep tu stages']
  }
  Note: 'Ten bo luat (khong chua luat)'
}

Table contract_type_stages [headercolor: #7a4fd1] {
  contract_type text [ref: > contract_types.code]
  sequence integer [note: '1, 2, 3...']
  milestone_type text [note: 'DELIVERY']
  name text [note: 'Giao hang']
  payment_percent "numeric(5,2)" [note: '40.00, tong cac moc <= 100']
  required_event_types "text[]" [note: '{DELIVERY, INVOICE}']
  invoice_required boolean
  late_penalty_applicable boolean
  offset_days integer [note: 'han = ngay bat dau + so ngay']
  release_rule_code text
  version integer
  created_at timestamptz
  updated_at timestamptz
  indexes {
    (contract_type, sequence) [pk]
  }
  Note: 'Moc mau (khuon) cua loai hop dong'
}

Table rule_versions [headercolor: #7a4fd1] {
  id text [pk, note: 'v1']
  name text
  status text [note: 'DRAFT -> PUBLISHED -> RETIRED']
  note text [null]
  created_by uuid [null, note: 'se noi toi users']
  published_by uuid [null, note: 'khac created_by']
  published_at timestamptz [null]
  version integer
  created_at timestamptz
  updated_at timestamptz
  Note: 'Phien ban luat; ban da cong bo thi khoa luat'
}

Table payment_rules [headercolor: #7a4fd1] {
  rule_id text [pk, note: 'PR0015']
  rule_version_id text [ref: > rule_versions.id]
  release_rule_code text [ref: > rule_scopes.release_rule_code]
  priority integer [note: '10..80, nho xet truoc']
  rule_name text
  rule_group text [note: 'BLOCKING | VALIDATION | PENALTY | RELEASE | FALLBACK']
  condition_expression text [note: 'open_dispute == TRUE, ELSE']
  decision text [note: 'RELEASE | HOLD | REJECT | PENALTY']
  reason_code text
  payable_amount_formula text
  penalty_amount_formula text
  rule_description_vi text
  active boolean
  version integer
  created_at timestamptz
  updated_at timestamptz
  indexes {
    (rule_version_id, release_rule_code, priority) [unique]
  }
  Note: 'Luat: neu ... thi ...'
}

// ============================ Hop dong ============================

Table parties [headercolor: #1f7a5a] {
  party_id text [pk, note: 'B009, S021, A025']
  party_name text
  party_type text [note: 'BUYER | SUPPLIER | APPROVER']
  parent_party_id text [null, ref: > parties.party_id, note: 'approver thuoc ben mua']
  organization_category text
  region text
  approval_role text
  approval_level integer
  approval_limit_vnd_mn "numeric(18,2)" [null]
  allowed_event_types "text[]"
  can_approve_payment boolean
  can_raise_dispute boolean
  status text
  version integer
  created_at timestamptz
  updated_at timestamptz
  Note: 'Cac ben: ben mua, nha cung cap, nguoi phe duyet'
}

Table contracts [headercolor: #1f7a5a] {
  contract_id text [pk, note: 'CT0001']
  contract_title text
  contract_type text [ref: > contract_types.code]
  buyer_id text [ref: > parties.party_id]
  supplier_id text [ref: > parties.party_id]
  contract_value_vnd_mn "numeric(18,2)" [note: '1290']
  signing_date date
  start_date date
  end_date date
  rule_version_id text [ref: > rule_versions.id, note: 'ban luat dung de cham']
  approval_policy text
  grace_period_days integer
  penalty_rate_pct_per_day "numeric(7,4)"
  max_penalty_pct "numeric(7,4)"
  lifecycle text [note: 'DRAFT | SIGNING | ACTIVE | CLOSED']
  version integer
  created_at timestamptz
  updated_at timestamptz
  Note: 'Hop dong'
}

Table milestones [headercolor: #1f7a5a] {
  milestone_id text [pk, note: 'MS0002']
  contract_id text [ref: > contracts.contract_id]
  milestone_sequence integer
  milestone_name text
  due_date date
  planned_payment_vnd_mn "numeric(18,2)" [note: '516 = 40% x 1290']
  required_event_types "text[]"
  invoice_required boolean
  late_penalty_applicable boolean
  release_rule_code text [ref: > rule_scopes.release_rule_code, note: 'chep tu moc mau']
  version integer
  created_at timestamptz
  updated_at timestamptz
  indexes {
    (contract_id, milestone_sequence) [unique]
  }
  Note: 'Moc that cua hop dong'
}

// Composite key: a stage's rule set must belong to the same contract type.
Ref: contract_type_stages.(contract_type, release_rule_code) > rule_scopes.(contract_type, release_rule_code)

TableGroup cau_hinh {
  contract_types
  rule_scopes
  contract_type_stages
  rule_versions
  payment_rules
}

TableGroup hop_dong {
  parties
  contracts
  milestones
}
