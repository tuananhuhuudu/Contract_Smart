{
  "name": "contract-smart",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @contract-smart/api dev",
    "build": "pnpm --filter @contract-smart/api build",
    "start": "pnpm --filter @contract-smart/api start",
    "typecheck": "pnpm --filter @contract-smart/api typecheck",
    "db:up": "docker compose -f infra/compose.yaml up -d --wait",
    "db:down": "docker compose -f infra/compose.yaml down"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
